//
//  ExternalDeveloper.xcconfig
//  DuckDuckGo (Softmax Browser SDK Fork)
//

// The Apple Developer account's Team ID (replace when signing for a physical iPhone/TestFlight)
DEVELOPMENT_TEAM = 

// The app bundle identifier for the Softmax DuckDuckGo iOS fork
APP_ID = com.softmax.duckduckgo.mobile.ios

// A prefix for group ids. Must start with "group.".
GROUP_ID_PREFIX = group.com.softmax.duckduckgo

// Automatic code signing for simulator / external developer builds
CODE_SIGN_STYLE = Automatic

// Clear manual provisioning profile specifier
PROVISIONING_PROFILE_SPECIFIER = 

// The keychain access group for subscriptions
SUBSCRIPTION_APP_GROUP = com.softmax.duckduckgo.subscriptions
